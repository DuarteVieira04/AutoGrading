<?php

namespace Tests\Feature;
use App\Models\ItemsOrder;
use Illuminate\Foundation\Testing\RefreshDatabase;

use Tests\TestCase;

class NewItemsOrderTest extends TestCase
{
   use RefreshDatabase;

    /** @test */
    public function it_displays_items_orders_index_page()
    {
        // Criar alguns dados
        ItemsOrder::factory()->count(3)->create();

        // Fazer request
        $response = $this->get(route('itemsOrders.index'));

        // Verificações
        $response->assertStatus(200);
        $response->assertViewIs('itemsOrders.index');
        $response->assertViewHas('itemsOrders');
    }
}